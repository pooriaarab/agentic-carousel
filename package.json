{
  "name": "agentic-carousel",
  "version": "0.1.0",
  "description": "Create JSON carousel decks and printable HTML with Instagram, LinkedIn, and TikTok text presets through a Node.js SDK, CLI, and MCP.",
  "keywords": [
    "carousel",
    "instagram",
    "linkedin",
    "tiktok",
    "slides",
    "html",
    "social-content",
    "json-deck",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "content-validation"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-carousel.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-carousel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-carousel": "./dist/cli.js",
    "agentic-carousel-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
